NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Auth, Postgres, Realtime)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Blob (product photos, logos)
BLOB_READ_WRITE_TOKEN=

# n8n ingest HMAC. Sign the raw JSON body; send hex in x-n8n-signature.
# Required for POST /api/n8n/ingest. The public demo uses PANTALLA_DEMO_SECRET.
N8N_WEBHOOK_SECRET=

# Public interview demo. Optional. Defaults to a repo-local demo secret.
PANTALLA_DEMO_SECRET=

# Command model. When OPENAI_API_KEY is unset, commands use the regex parser.
OPENAI_API_KEY=
PANTALLA_COMMAND_MODEL=gpt-4o-mini

# MailerSend SMTP (admin support mail)
# Host smtp.mailersend.net, port 587, STARTTLS. From must be a verified domain.
MAILERSEND_SMTP_HOST=smtp.mailersend.net
MAILERSEND_SMTP_PORT=587
MAILERSEND_SMTP_USER=
MAILERSEND_SMTP_PASS=
MAILERSEND_FROM_EMAIL=
MAILERSEND_FROM_NAME=Pantalla
CONTACT_TO_EMAIL=
